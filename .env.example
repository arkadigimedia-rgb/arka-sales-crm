# PostgreSQL database connection string (Neon, Supabase, Railway, AWS RDS, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 32+ character random secret for signing session JWT tokens
AUTH_SECRET=generate-a-long-random-secret-at-least-32-characters

